# Required — Bedrock Knowledge Base
FOLKORE_KB_ID=your-kb-id
FOLKORE_KB_DATA_SOURCE_ID=your-kb-data-source-id
FOLKORE_KB_BUCKET=your-kb-bucket-name

# Required — Bedrock Mantle gateway
MANTLE_API_KEY=your-mantle-api-key
MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
MANTLE_MODEL=deepseek.v3.2

# Local development only (not needed when deploying to Lambda)
AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile
